{
  "$schema": "https://raw.githubusercontent.com/platformio/platformio-core/develop/platformio/assets/schema/library.json",
  "name": "CRC Forge",
  "version": "1.1.1",
  "description": "Heap-free CRC checksums for embedded C++11 on AVR and ESP32. Supports optional CRC-8/SMBUS, SAE-J1850, AUTOSAR, CRC-16/IBM-3740 and CRC-32/ISO-HDLC. Select bitwise or 16/256-entry table backends, with AVR flash tables, direct classes, enum dispatch and incremental or cooperative processing.",
  "keywords": [
    "crc",
    "checksum",
    "crc8",
    "crc16",
    "crc32",
    "embedded",
    "heap-free",
    "incremental",
    "lookup-table",
    "autosar",
    "smbus"
  ],
  "authors": [
    {
      "name": "Christof Seidel"
    }
  ],
  "frameworks": "*",
  "platforms": "*",
  "headers": [
    "Crc.h"
  ],
  "build": {
    "srcDir": ".",
    "includeDir": ".",
    "srcFilter": "-<*> +<Crc.cpp> +<src/*.cpp>",
    "flags": [
      "-fno-exceptions",
      "-fno-rtti",
      "-Wall",
      "-Wextra",
      "-Wconversion",
      "-Wsign-conversion",
      "-Wundef",
      "-Werror"
    ]
  },
  "export": {
    "include": [
      "Crc.h",
      "Crc.cpp",
      "Crc_Cfg.h",
      "Crc_Types.h",
      "src",
      "examples",
      "test",
      "platformio.ini",
      "README.md",
      "library.json",
      "scripts",
      "LICENSE"
    ],
    "exclude": [
      "**/.pio/**",
      "src/CrcIf.cpp",
      "**/__pycache__/**",
      "**/*.pyc"
    ]
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CodeName-666/CRC-Forge.git"
  },
  "homepage": "https://github.com/CodeName-666/CRC-Forge"
}
